{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "America/Toronto",
  "rebaseWhen": "conflicted",
  "commitBodyTable": true,
  "printConfig": true,
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "enabledManagers": [
    "asdf",
    "custom.regex",
    "dockerfile",
    "github-actions"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "asdf"
      ],
      "commitMessageTopic": "tool {{depName}}",
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch"
      ],
      "semanticCommitType": "chore",
      "semanticCommitScope": "tools",
      "addLabels": [
        "tools"
      ]
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "commitMessageTopic": "docker {{depName}}",
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch"
      ],
      "semanticCommitType": "chore",
      "semanticCommitScope": "docker",
      "bumpVersion": "patch",
      "addLabels": [
        "docker"
      ]
    },
    {
      "matchDatasources": [
        "git-refs"
      ],
      "commitMessageTopic": "upstream {{depName}}",
      "semanticCommitType": "chore",
      "semanticCommitScope": "upstream",
      "addLabels": [
        "upstream"
      ]
    },
    {
      "matchDatasources": [
        "github-actions"
      ],
      "commitMessageTopic": "github action {{depName}}",
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch"
      ],
      "semanticCommitType": "chore",
      "semanticCommitScope": "ci",
      "addLabels": [
        "ci"
      ]
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "addLabels": [
        "major"
      ]
    },
    {
      "matchUpdateTypes": [
        "minor"
      ],
      "addLabels": [
        "minor"
      ]
    },
    {
      "matchUpdateTypes": [
        "patch"
      ],
      "addLabels": [
        "patch"
      ]
    }
  ],
  "labels": [
    "renovate"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Upstream source commits pinned as ARGs in image Dockerfiles",
      "managerFilePatterns": [
        "/(^|/)Dockerfile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) branch=(?<currentValue>\\S+)\\nARG \\S+=(?<currentDigest>[a-f0-9]{40})"
      ]
    }
  ],
  "pinDigests": true
}
